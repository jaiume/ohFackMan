* text=auto eol=lf

# Treat common images/binaries as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.bz2 binary

# PHP/JS/CSS treated as text for diffing
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.md text eol=lf

